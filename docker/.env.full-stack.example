# Full Stack Local Environment Configuration
# Copy this to .env.full-stack and fill in your values

# ============================================================================
# GraphQL Proxy Configuration
# ============================================================================

# Proxy API key (for workers to authenticate with the proxy)
PLEXUS_PROXY_API_KEY=local-dev-key

# Upstream AWS AppSync (for control-plane data like scorecards, scores)
PLEXUS_API_URL=https://your-appsync-endpoint.appsync-api.us-east-1.amazonaws.com/graphql
PLEXUS_API_KEY=your-appsync-api-key

# ============================================================================
# Plexus Account Configuration
# ============================================================================

PLEXUS_ACCOUNT_KEY=your-account-key

# ============================================================================
# LLM API Keys (for scoring)
# ============================================================================

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI (if using)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ============================================================================
# AWS Credentials (for S3 attachments, etc)
# ============================================================================

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-west-2

# ============================================================================
# SQS Configuration (only if using score-processor mode)
# ============================================================================

PLEXUS_SCORING_WORKER_REQUEST_STANDARD_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456/dev-scoring-requests
PLEXUS_RESPONSE_WORKER_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456/dev-scoring-responses

# ============================================================================
# RabbitMQ Configuration (automatically set by docker-compose)
# ============================================================================

# These are set by docker-compose for the celery worker
# CELERY_BROKER_URL=amqp://plexus:plexus@rabbitmq:5672/
# CELERY_RESULT_BACKEND=rpc://

# ============================================================================
# Worker Configuration
# ============================================================================

LOG_LEVEL=DEBUG
MAX_JOBS_PER_WORKER=10
