# Plexus Docker Environment Variables
# Copy this file to .env and fill in your actual values

# Plexus API Configuration
PLEXUS_API_URL=https://api.plexus.example.com
PLEXUS_API_KEY=your-api-key-here
PLEXUS_ACCOUNT_KEY=your-account-key-here

# AWS Configuration (for score-processor worker)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# SQS Queue URLs (for score-processor worker)
PLEXUS_SCORING_WORKER_REQUEST_STANDARD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/plexus-scoring-requests
PLEXUS_RESPONSE_WORKER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/plexus-scoring-responses

# Console Worker Configuration
CONSOLE_RESPONSE_TARGET=local:developer

# Optional: Override Celery broker (default uses RabbitMQ from docker-compose)
# CELERY_BROKER_URL=amqp://user:pass@external-rabbitmq:5672//

# Optional: Logging
LOG_LEVEL=INFO
